{
  "name": "Driver",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "iqama_no": {
      "type": "string"
    },
    "name2": {
      "type": "string",
      "description": "Second driver name (optional, same vehicle)"
    },
    "iqama_no2": {
      "type": "string",
      "description": "Second driver iqama number"
    },
    "vehicle_plate": {
      "type": "string"
    },
    "car_model": {
      "type": "string"
    },
    "company_id": {
      "type": "string",
      "description": "CompanyTemplate id this driver belongs to (empty = available to all companies)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name"
  ]
}