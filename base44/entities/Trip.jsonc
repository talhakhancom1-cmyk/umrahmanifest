{
  "name": "Trip",
  "type": "object",
  "properties": {
    "trip_name": {
      "type": "string"
    },
    "route_from": {
      "type": "string"
    },
    "route_to": {
      "type": "string"
    },
    "travel_date": {
      "type": "string",
      "format": "date"
    },
    "trip_time": {
      "type": "string"
    },
    "second_party_name": {
      "type": "string"
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "iqama_no": {
            "type": "string"
          }
        }
      }
    },
    "vehicle_plate": {
      "type": "string"
    },
    "car_model": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "company_name_ar": {
      "type": "string"
    },
    "cr_number": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "stamp_url": {
      "type": "string"
    },
    "qr_url": {
      "type": "string"
    },
    "footer_ar": {
      "type": "string"
    },
    "footer_en": {
      "type": "string"
    },
    "template_url": {
      "type": "string",
      "description": "Company manifest template URL used to render this trip's document"
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id_number": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          }
        }
      }
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "trip_name",
    "route_from",
    "route_to",
    "travel_date"
  ]
}