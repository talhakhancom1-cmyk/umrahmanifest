{
  "name": "WhatsAppSession",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "collecting",
        "awaiting_route",
        "awaiting_datetime",
        "awaiting_company",
        "awaiting_driver",
        "done"
      ],
      "default": "idle"
    },
    "route_from": {
      "type": "string",
      "enum": [
        "Madina",
        "Makkah",
        "Riyadh",
        "Dammam",
        "Jeddah",
        "Zalim",
        "Tayab",
        "Al_Qasim",
        "Ramazia"
      ]
    },
    "route_to": {
      "type": "string",
      "enum": [
        "Madina",
        "Makkah",
        "Riyadh",
        "Dammam",
        "Jeddah",
        "Zalim",
        "Tayab",
        "Al_Qasim",
        "Ramazia"
      ]
    },
    "travel_date": {
      "type": "string",
      "format": "date"
    },
    "trip_time": {
      "type": "string"
    },
    "company_menu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "company_id": {
      "type": "string"
    },
    "driver_menu": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "iqama_no": {
            "type": "string"
          },
          "name2": {
            "type": "string"
          },
          "iqama_no2": {
            "type": "string"
          },
          "vehicle_plate": {
            "type": "string"
          },
          "car_model": {
            "type": "string"
          }
        }
      }
    },
    "driver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "iqama_no": {
          "type": "string"
        },
        "name2": {
          "type": "string"
        },
        "iqama_no2": {
          "type": "string"
        },
        "vehicle_plate": {
          "type": "string"
        },
        "car_model": {
          "type": "string"
        }
      }
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id_number": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          },
          "gender": {
            "type": "string"
          }
        }
      }
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trip_id": {
      "type": "string"
    }
  },
  "required": [
    "phone_number"
  ]
}