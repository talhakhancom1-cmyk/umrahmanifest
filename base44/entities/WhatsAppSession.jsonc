{
  "name": "WhatsAppSession",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "idle",
        "collecting",
        "awaiting_route",
        "awaiting_datetime",
        "done"
      ],
      "default": "idle"
    },
    "route_from": {
      "type": "string",
      "enum": [
        "Madina",
        "Makkah"
      ]
    },
    "route_to": {
      "type": "string",
      "enum": [
        "Madina",
        "Makkah"
      ]
    },
    "travel_date": {
      "type": "string",
      "format": "date"
    },
    "trip_time": {
      "type": "string"
    },
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "id_number": {
            "type": "string"
          },
          "nationality": {
            "type": "string"
          }
        }
      }
    },
    "photo_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trip_id": {
      "type": "string"
    }
  },
  "required": [
    "phone_number"
  ]
}