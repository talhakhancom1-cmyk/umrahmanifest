{
  "name": "WhatsAppSetting",
  "type": "object",
  "properties": {
    "phone_number_id": {
      "type": "string"
    },
    "access_token": {
      "type": "string"
    },
    "verify_token": {
      "type": "string"
    },
    "app_url": {
      "type": "string",
      "description": "Base URL of the deployed app, e.g. https://myapp.base44.app"
    }
  },
  "required": [
    "phone_number_id",
    "access_token",
    "verify_token"
  ]
}